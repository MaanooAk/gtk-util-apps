import re
import math
import random
import humanize

def number(text):
    try: return int(text.replace(",", ""))
    except: return float(text.replace(",", ""))

operations = {
    "pi": ("Push π", 0, lambda s: s.append(math.pi)),
    "tau": ("Push τ", 0, lambda s: s.append(math.tau)),
    "e": ("Push Euler's number", 0, lambda s: s.append(math.e)),
    "inf": ("Push Infinity", 0, lambda s: s.append(math.inf)),
    "random": ("Push random number in [0,1)", 0, lambda s: s.append(random.random())),

    "int": ("Convert top to int", 1, lambda s: s.append(int(s.pop()))),
    "float": ("Convert top to float", 1, lambda s: s.append(float(s.pop()))),
    "round": ("Round top", 1, lambda s: s.append(math.floor(s.pop() + 0.5))),
    "ceil": ("Ceiling top", 1, lambda s: s.append(math.ceil(s.pop()))),
    "floor": ("Floor top", 1, lambda s: s.append(math.floor(s.pop()))),
    "fac": ("Factorial top", 1, lambda s: s.append(math.factorial(s.pop()))),

    "sum": ("Sum stack", 1, lambda s: s.__setitem__(slice(None), [sum(s)])),
    "avg": ("Average stack", 1, lambda s: s.__setitem__(slice(None), [sum(s) / len(s)])),
    "min": ("Min of stack", 1, lambda s: s.__setitem__(slice(None), [min(s)])),
    "max": ("Max of stack", 1, lambda s: s.__setitem__(slice(None), [max(s)])),
    "prod": ("Product stack", 1, lambda s: s.__setitem__(slice(None), [math.prod(s)])),

    "u": ("Format units top", 1, lambda s: s.append(humanize.intcomma(s.pop()))),
    "b": ("Format bytes top", 1, lambda s: s.append(humanize.naturalsize(s.pop(), binary=True))),
    "s": ("Format seconds top", 1, lambda s: s.append(humanize.precisedelta(s.pop()))),
    "m": ("Format minutes top", 1, lambda s: s.append(humanize.precisedelta(s.pop() * 60))),
    "h": ("Format hours top", 1, lambda s: s.append(humanize.precisedelta(s.pop() * 60 * 60))),
    "f": ("Format scientific top", 1, lambda s: s.append(humanize.scientific(s.pop()))),

}

def calc(text):
    text = text.strip()
    if len(text) == 0: return 0

    tokens = re.findall(r"([-+*/\\^]?[0-9.,_]+|[*/\\]{1,2}|[-+|^]|[=]?[a-z]+)", text)

    vars = {}
    stack = []
    for i in tokens:
        if i in "+-|**//\\\\^":
            if len(stack) >= 2:
                a, b = stack.pop(), stack.pop()
                if i == "+": stack.append(b + a)
                elif i == "-": stack.append(b - a)
                elif i == "|": stack.append(a - b)
                elif i == "*": stack.append(b * a)
                elif i == "/": stack.append(b / a)
                elif i == "\\": stack.append(a / b)
                elif i == "^": stack.append(b ** a)
                elif i == "**": stack.append(b ** a)
                elif i == "//": stack.append(b // a)
                elif i == "\\\\": stack.append(a // b)
        elif i[0] in "+-*/\\^" and len(i) > 1:
            a, b = number(i[1:]), stack.pop()
            if i[0] == "+": stack.append(b + a)
            elif i[0] == "-": stack.append(b - a)
            elif i[0] == "|": stack.append(a - b)
            elif i[0] == "*": stack.append(b * a)
            elif i[0] == "/": stack.append(b / a)
            elif i[0] == "\\": stack.append(a / b)
            elif i[0] == "^": stack.append(b ** a)
        elif i[0] == "=":
            name = i[1:]
            vars[name] = stack.pop()
        elif i[0].isalpha():
            if i in vars:
                stack.append(vars[i])
            elif i in operations:
                desc, argc, func = operations[i]
                if len(stack) >= argc:
                    func(stack)
            else:
                pass
        else:
            stack.append(number(i))
    if len(stack) == 0:
        return "0"
    return " ".join(map(str, stack))

